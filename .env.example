# ─────────────────────────────────────────────────────────────
# HireHand AI Backend — Environment Variables
# Copy this to `.env` on the EC2 server and fill in REAL values.
# NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# --- Core ---
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxx.mongodb.net/?appName=Cluster0
SECRET_KEY=<a-long-random-string-for-jwt>
FRONTEND_URL=https://www.soumyajitbanerjee.in

# ─────────────────────────────────────────────────────────────
# AI — ALL providers point to Groq (OpenAI-compatible endpoint).
# Same key/model used everywhere. Model: openai/gpt-oss-120b.
# ─────────────────────────────────────────────────────────────

# 1) Main AI  (resume screening, psychometric, assessment, dashboard AI tools)
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=gsk_your_groq_key_here
AI_MODEL=openai/gpt-oss-120b

# 2) Interview AI  (live AI interviewer + InterviewIQ analysis)
INTERVIEW_AI_URL=https://api.groq.com/openai/v1/chat/completions
INTERVIEW_AI_KEY=gsk_your_groq_key_here
INTERVIEW_AI_MODEL=openai/gpt-oss-120b

# 3) Insight AI chatbot  (transcript RAG chat)
CHATBOT_AI_API_URL=https://api.groq.com/openai/v1/chat/completions
CHATBOT_AI_API_KEY=gsk_your_groq_key_here
CHATBOT_AI_MODEL=openai/gpt-oss-120b

# ── Job Recommendations — semantic embeddings (Google AI Studio / Gemini) ──
# A FRESH Google AI Studio key (the old one was auto-disabled as leaked).
# If unset, recommendations fall back to structured skill matching.
EMBEDDING_API_KEY=your_fresh_gemini_key_here
EMBEDDING_MODEL=text-embedding-004

# Optional: dedicated Groq keys per InterviewIQ analysis chain (avoids the
# 8000 TPM free-tier limit when 3 report calls fire back-to-back).
INTERVIEW_AI_KEY_2=gsk_second_groq_account_key
INTERVIEW_AI_KEY_3=gsk_third_groq_account_key

# --- Email (Resend) — REQUIRED ---
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=HireHand AI <updates@soumyajitbanerjee.in>
RESEND_REPORTS_EMAIL=HireHand Reports <reports@soumyajitbanerjee.in>

# --- Optional feature keys (leave blank if unused) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# DEEPGRAM_API_KEY=
# DEEPGRAM_PROJECT_ID=
# METERED_API_KEY=
# METERED_APP_NAME=hirehand
